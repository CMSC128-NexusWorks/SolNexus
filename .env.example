# PostgreSQL (warehouse + Airflow metadata)
POSTGRES_USER=solnexus
POSTGRES_PASSWORD=solnexus
POSTGRES_DB=solnexus
POSTGRES_PORT=5433

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql://solnexus:solnexus@postgres:5432/solnexus
# Browser origins allowed to call the API with the session cookie (comma-separated)
CORS_ORIGINS=http://localhost:5173
# Keep true. Set false only if you test locally in Safari, which rejects Secure cookies on http://localhost
SESSION_COOKIE_SECURE=true

# Frontend
WEB_PORT=5173
VITE_API_URL=http://localhost:8000
# true = frontend uses its built-in mock API (src/mocks) until the backend endpoints exist
VITE_USE_MOCKS=true

# Airflow
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
# On Linux set this to your user ID (`id -u`) so Airflow can read the owner-only Gmail token in .secrets/.
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=V_gRnQXwdpfBA2KjQZuB_VnckIGPT3o-hqFKbkW8kJU=
AIRFLOW_WEBSERVER_SECRET_KEY=local-dev-webserver-secret

# Gmail ingestion (SNX-32). OAuth files live in .secrets/ (git-ignored), not here; see airflow/README.md.
# Optional Gmail label ID that marks lead-related mail; empty ingests the whole mailbox.
GMAIL_LABEL_ID=
# Bounds the first full sync (and recovery resyncs); later runs are incremental.
GMAIL_BACKFILL_QUERY=newer_than:30d
